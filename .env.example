# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# Required only for the Anthropic provider and the opt-in live test.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Opt-in live test (costs money): set to 1 to enable tests/live/.
HOLLIS_LIVE_TESTS=0
# Model used by the live test.
HOLLIS_LIVE_MODEL=claude-opus-5-5
