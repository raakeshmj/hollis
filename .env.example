# Copy to .env (git-ignored) or export in your shell. Never commit real values.
# Deployments in hollis.toml name the variables they read; these match hollis.example.toml.
ANTHROPIC_API_KEY=sk-ant-your-key-here
CORP_INFERENCE_TOKEN=your-gateway-token

# Opt-in live tests (cost money for cloud endpoints).
HOLLIS_LIVE_TESTS=0
HOLLIS_LIVE_MODEL=claude-opus-5-5

# Opt-in conformance against any endpoint (no key needed for local servers).
# HOLLIS_CONFORMANCE_PROTOCOL=openai-chat-completions
# HOLLIS_CONFORMANCE_BASE_URL=http://127.0.0.1:11434/v1
# HOLLIS_CONFORMANCE_MODEL=qwen3:8b
# HOLLIS_CONFORMANCE_PROVIDER=ollama
# HOLLIS_CONFORMANCE_AUTH_ENV=
